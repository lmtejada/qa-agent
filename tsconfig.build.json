{
  // Emits src/ to dist/. Used only by `npm run build`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true
  },
  "include": ["src"],
  // Tests run from src/ with tsx; they are not part of the build.
  "exclude": ["src/**/*.test.ts"]
}
