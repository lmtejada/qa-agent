# Copy to .env and adjust. .env is git-ignored; every variable is validated in src/shared/config.ts.

# Runtime environment: development | test | production. Optional, defaults to development.
NODE_ENV=development

# Minimum log level: debug | info | warn | error. Optional, defaults to info.
LOG_LEVEL=info

# Human-readable app name shown in logs. Required.
APP_NAME=qa-agent

# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey). Required. Secret.
GOOGLE_GENERATIVE_AI_API_KEY=

# Gemini model that generates the test cases. Optional, defaults to gemini-3.5-flash.
GEMINI_MODEL=gemini-3.5-flash

# Port the HTTP server (npm run serve) listens on. Optional, defaults to 3000.
PORT=3000

# Interface the HTTP server binds to. Optional, defaults to 127.0.0.1 (this machine only).
# The server has no authentication, so only use 0.0.0.0 on a trusted network.
HOST=127.0.0.1
