{
  "name": "qa-agent",
  "version": "0.1.0",
  "private": true,
  "description": "CLI QA agent that turns user stories into test cases using Gemini",
  "license": "ISC",
  "author": "Laura Tejada",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#/*": {
      "template-source": "./src/*",
      "default": "./dist/*"
    }
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.122",
    "ai": "^7.0.176",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "scripts": {
    "dev": "tsx watch --conditions=template-source src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli/index.js",
    "dev:server": "tsx watch --conditions=template-source src/server/index.ts",
    "serve": "node dist/server/index.js",
    "test": "tsx --conditions=template-source --test \"src/**/*.test.ts\"",
    "typecheck": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm audit --audit-level=high",
    "prepare": "husky"
  },
  "allowScripts": {
    "esbuild": false,
    "unrs-resolver": false,
    "fsevents": false
  },
  "lint-staged": {
    "*.{ts,mts,cts,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,md,yml,yaml}": "prettier --write"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
